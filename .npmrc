# The LAN npm cache (Verdaccio on the docker-registry box).
#
# ⚠ WHY THIS FILE MATTERS HERE. The internet on this network runs at roughly 37 KB/s — a
# 4.5 MB package does not finish inside two minutes. Installing a full node_modules straight
# from npmjs.org is a multi-hour operation that usually fails first, which is exactly why
# three frontend images would not build on 2026-08-01.
#
# Verdaccio is a caching PROXY, not a private registry: the first install of a package
# fetches it from npmjs.org and every install after that is served from the LAN. Measured
# on the same day: 0.8 s from npm, 0.006 s from cache.
#
# ⚠ IT IS DECLARED, so it comes back if the box is rebuilt:
#     dev8x/forge/infrastructure/desired-state/services/docker-registry.yaml -> npm_cache
#     ansible-playbook setup-docker-registry.yml --tags npm
#
# It vanished once already — the old container was created with `restart: no`, exited on
# 2026-02-19 and stayed dead for five months while every build silently used the internet.
registry=http://192.168.1.201:4873/

# Do not fail the whole install because one slow package timed out.
fetch-retries=5
fetch-retry-maxtimeout=600000
fetch-timeout=600000
