# ─── ADE Provider ───
# agent-sdk = Pro-credit Agent SDK (default dev, no API key needed)
# api       = Anthropic API key (production)
# local     = Ollama local model (fallback/offline)
ADE_PROVIDER=agent-sdk

# ─── Model ───
ADE_MODEL=claude-sonnet-4-6
ADE_GENERATOR_MODEL=
ADE_CRITIC_MODEL=

# ─── Budget caps (hard, F-MOD-04) ───
ADE_MAX_RUN_TOKENS=500000
ADE_MAX_RUN_SECONDS=600
ADE_MAX_MODEL_CALLS=30

# ─── Temperatures ───
ADE_GEN_TEMPERATURE=0.7
ADE_CRITIC_TEMPERATURE=0.2

# Phase 2 Library embeddings
ADE_EMBEDDING_PROVIDER=local-hash
ADE_EMBEDDING_MODEL=ade-local-hash-v1

# Phase 4 production/autonomy controls
# Production mode requires ADE_PROVIDER=api and ANTHROPIC_API_KEY.
ADE_PRODUCTION=false
ADE_HARNESS=vite
ADE_AUTONOMY_RUNG=0
ADE_MAX_TOKENS_PER_SECTION=200000
ADE_MAX_SECONDS_PER_SECTION=300
ADE_MAX_USD_PER_SECTION=50

# ─── API key (only for ADE_PROVIDER=api) ───
ANTHROPIC_API_KEY=

# ─── Ollama (only for ADE_PROVIDER=local) ───
ADE_OLLAMA_BASE_URL=http://localhost:11434
ADE_OLLAMA_MODEL=llava
