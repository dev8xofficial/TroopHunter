{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Foundation Validation Schema — Admin Portal",
  "description": "Validates design tokens, navigation structure, session context, audit log contract, and badge system for the Foundation layer (000).",
  "type": "object",
  "properties": {
    "design_tokens": {
      "type": "object",
      "required": ["colours", "typography", "shadows", "spacing", "breakpoints"],
      "properties": {
        "colours": {
          "type": "object",
          "required": ["primary_navy", "primary_gold", "accent_blue", "success_green", "warning_orange", "error_red"],
          "properties": {
            "primary_navy": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "const": "#1a3a52" },
            "primary_gold": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "const": "#fdb913" },
            "accent_blue": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "const": "#2d5a7b" },
            "success_green": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "const": "#10b981" },
            "warning_orange": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "const": "#f59e0b" },
            "error_red": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "const": "#ef4444" }
          }
        },
        "typography": {
          "type": "object",
          "required": ["font_display", "font_body"],
          "properties": {
            "font_display": { "type": "string", "const": "Archivo" },
            "font_body": { "type": "string", "const": "Manrope" }
          }
        },
        "shadows": {
          "type": "object",
          "required": ["sm", "md", "lg", "xl"],
          "properties": {
            "sm": { "type": "string" },
            "md": { "type": "string" },
            "lg": { "type": "string" },
            "xl": { "type": "string" }
          }
        },
        "spacing": {
          "type": "object",
          "properties": {
            "container_max_width": { "type": "string", "const": "1600px" },
            "page_padding": { "type": "string", "const": "32px" },
            "card_border_radius": { "type": "string", "const": "16px" },
            "button_border_radius": { "type": "string", "const": "10px" },
            "badge_border_radius": { "type": "string", "const": "6px" },
            "input_border_radius": { "type": "string", "const": "8px" }
          }
        },
        "breakpoints": {
          "type": "object",
          "properties": {
            "full": { "type": "integer", "const": 1200 },
            "tablet": { "type": "integer", "const": 768 }
          }
        }
      }
    },
    "navigation": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "route_id"],
            "properties": {
              "label": { "type": "string" },
              "route_id": { "type": "string" },
              "icon": { "type": "string" }
            }
          },
          "minItems": 6,
          "maxItems": 6
        }
      }
    },
    "session_context": {
      "type": "object",
      "required": ["admin_name", "admin_initials", "role", "organisation"],
      "properties": {
        "admin_name": { "type": "string", "minLength": 2 },
        "admin_initials": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "role": { "type": "string", "enum": ["ADMIN", "TC"] },
        "organisation": { "type": "string" },
        "pending_documents": { "type": "integer", "minimum": 0 },
        "pending_partners": { "type": "integer", "minimum": 0 },
        "pending_users": { "type": "integer", "minimum": 0 },
        "unread_notification_count": { "type": "integer", "minimum": 0 }
      }
    },
    "badge_variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class_name", "usage"],
        "properties": {
          "class_name": { "type": "string", "enum": ["active", "pending", "completed", "error"] },
          "usage": { "type": "string" }
        }
      },
      "minItems": 4,
      "maxItems": 4
    },
    "audit_log_event": {
      "type": "object",
      "required": ["log_id", "action_type", "actor_id", "target_entity_id", "timestamp"],
      "properties": {
        "log_id": { "type": "string" },
        "action_type": {
          "type": "string",
          "enum": [
            "USER_CREATED", "USER_SUSPENDED", "USER_APPROVED",
            "PARTNER_APPROVED", "PARTNER_SUSPENDED", "PARTNER_ACTIVATED",
            "DOCUMENT_APPROVED", "DOCUMENT_REJECTED",
            "STAGE_UPDATE_APPROVED", "STAGE_UPDATE_OVERRIDE",
            "TRANSACTION_CREATED", "TRANSACTION_EDITED"
          ]
        },
        "actor_id": { "type": "string" },
        "target_entity_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "reason_text": { "type": "string" }
      }
    }
  }
}
