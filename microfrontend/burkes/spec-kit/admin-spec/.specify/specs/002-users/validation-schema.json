{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Users Management Validation Schema",
  "description": "Validates data model for the Users Management screen (002).",
  "type": "object",
  "properties": {
    "feature_id": { "type": "string", "const": "002-users" },
    "depends_on": { "type": "array", "contains": { "const": "000-foundation" } },
    "user": {
      "type": "object",
      "required": ["id", "first_name", "last_name", "email", "role", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^USR-[A-Z]{3}-[0-9]{3}$" },
        "first_name": { "type": "string", "minLength": 1, "maxLength": 50 },
        "last_name": { "type": "string", "minLength": 1, "maxLength": 50 },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["client", "agent", "attorney", "cpa", "lender", "admin"] },
        "status": { "type": "string", "enum": ["active", "pending-approval", "suspended", "inactive"] },
        "joined_date": { "type": "string", "format": "date" },
        "avatar_initials": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "avatar_bg": { "type": "string" }
      }
    },
    "role_permissions": {
      "type": "object",
      "description": "Maps each role to its auto-configured permission set",
      "properties": {
        "admin": { "type": "array", "items": { "type": "string" }, "minItems": 12 },
        "agent": { "type": "array", "items": { "type": "string" }, "minItems": 4 },
        "client": { "type": "array", "items": { "type": "string" }, "minItems": 3 },
        "attorney": { "type": "array", "items": { "type": "string" }, "minItems": 5 },
        "cpa": { "type": "array", "items": { "type": "string" }, "minItems": 3 },
        "lender": { "type": "array", "items": { "type": "string" }, "minItems": 5 }
      }
    },
    "filters": {
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "status": { "type": "string" },
        "search": { "type": "string" }
      }
    },
    "pagination": {
      "type": "object",
      "required": ["total", "page", "per_page"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "page": { "type": "integer", "minimum": 1 },
        "per_page": { "type": "integer", "const": 6 }
      }
    }
  },
  "required": ["feature_id", "depends_on"]
}
