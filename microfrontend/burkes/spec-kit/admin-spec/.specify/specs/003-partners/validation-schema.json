{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Partners Management Validation Schema",
  "description": "Validates data model for the Service Partners Management screen (003).",
  "type": "object",
  "properties": {
    "feature_id": { "type": "string", "const": "003-partners" },
    "depends_on": { "type": "array", "contains": { "const": "000-foundation" } },
    "partner": {
      "type": "object",
      "required": ["company_name", "category", "contact_name", "phone", "email", "license_number", "service_zips", "status"],
      "properties": {
        "company_name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "category": { "type": "string", "enum": ["plumbing", "roofing", "electrical", "credit-repair", "hvac", "painting", "landscaping", "flooring", "other"] },
        "contact_name": { "type": "string", "minLength": 1 },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "license_number": { "type": "string", "minLength": 1 },
        "service_zips": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9]{5}$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "rating": { "type": ["number", "null"], "minimum": 1, "maximum": 5 },
        "status": { "type": "string", "enum": ["active", "pending-approval", "suspended", "inactive"] },
        "insurance_verified": { "type": "string", "enum": ["pending", "yes", "no"] }
      }
    },
    "filters": {
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "zip_code": { "type": "string", "pattern": "^[0-9]{5}$" },
        "status": { "type": "string" },
        "search": { "type": "string" }
      }
    },
    "pagination": {
      "type": "object",
      "required": ["total", "page", "per_page"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "page": { "type": "integer", "minimum": 1 },
        "per_page": { "type": "integer", "const": 6 }
      }
    }
  },
  "required": ["feature_id", "depends_on"]
}
