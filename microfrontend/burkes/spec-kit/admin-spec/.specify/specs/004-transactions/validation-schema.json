{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transactions Management Validation Schema",
  "description": "Validates data model for the Transactions Management screen (004).",
  "type": "object",
  "properties": {
    "feature_id": { "type": "string", "const": "004-transactions" },
    "depends_on": { "type": "array", "contains": { "const": "000-foundation" } },
    "transaction": {
      "type": "object",
      "required": ["id", "client_name", "property_address", "type", "stage", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^TRX-[0-9]{5}$" },
        "client_name": { "type": "string", "minLength": 1 },
        "property_address": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["purchase", "sale", "refinance", "divorce-asset-split"] },
        "amount": { "type": ["number", "null"], "minimum": 0 },
        "stage": { "type": "string" },
        "closing_date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["on-track", "closing-soon", "delayed", "at-risk", "completed"] }
      }
    },
    "pending_approval": {
      "type": "object",
      "required": ["type", "transaction_id"],
      "properties": {
        "type": { "type": "string", "enum": ["attorney-verification", "stage-update"] },
        "transaction_id": { "type": "string", "pattern": "^TRX-[0-9]{5}$" },
        "notes": { "type": "string" },
        "submitted_by": { "type": "string" }
      }
    },
    "filters": {
      "type": "object",
      "properties": {
        "stage": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "search": { "type": "string" }
      }
    },
    "pagination": {
      "type": "object",
      "required": ["total", "page", "per_page"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "page": { "type": "integer", "minimum": 1 },
        "per_page": { "type": "integer", "const": 5 }
      }
    }
  },
  "required": ["feature_id", "depends_on"]
}
