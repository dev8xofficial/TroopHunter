{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dashboard Validation Schema",
  "description": "Validates data model for the Admin Dashboard screen (001).",
  "type": "object",
  "properties": {
    "feature_id": { "type": "string", "const": "001-dashboard" },
    "depends_on": { "type": "array", "contains": { "const": "000-foundation" } },
    "kpi_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "value", "description", "icon"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "description": { "type": "string" },
          "icon": { "type": "string" },
          "breakdown_tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "minItems": 4,
      "maxItems": 4
    },
    "quick_management_tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "icon", "gradient", "count", "label"],
        "properties": {
          "title": { "type": "string" },
          "icon": { "type": "string" },
          "gradient": { "type": "string" },
          "description": { "type": "string" },
          "count": { "type": "integer", "minimum": 0 },
          "label": { "type": "string" }
        }
      },
      "minItems": 4,
      "maxItems": 4
    },
    "pending_approvals": {
      "type": "object",
      "required": ["urgent_documents", "partner_applications", "user_registrations"],
      "properties": {
        "urgent_documents": { "type": "integer", "minimum": 0 },
        "partner_applications": { "type": "integer", "minimum": 0 },
        "user_registrations": { "type": "integer", "minimum": 0 }
      }
    },
    "today_stats": {
      "type": "object",
      "required": ["new_users", "docs_processed", "transactions_closed"],
      "properties": {
        "new_users": { "type": "integer", "minimum": 0 },
        "docs_processed": { "type": "integer", "minimum": 0 },
        "transactions_closed": { "type": "integer", "minimum": 0 }
      }
    },
    "admin_quick_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "icon"],
        "properties": {
          "label": { "type": "string" },
          "icon": { "type": "string" }
        }
      },
      "minItems": 2
    }
  },
  "required": ["feature_id", "depends_on", "kpi_cards", "pending_approvals"]
}
