{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Documents Validation Schema",
  "description": "Validates data model for the Documents screen (005).",
  "type": "object",
  "properties": {
    "feature_id": { "type": "string", "const": "005-documents" },
    "depends_on": { "type": "array", "contains": { "const": "000-foundation" } },
    "document": {
      "type": "object",
      "required": ["name", "category", "transaction_id", "uploaded_by", "date", "status"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "enum": ["purchase-sales-agreement", "closing-disclosure", "mortgage-documents", "insurance", "title", "divorce", "inspection-report"]
        },
        "transaction_id": { "type": "string", "pattern": "^TRX-[0-9]{5}$" },
        "uploaded_by": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["needs-review", "under-review", "approved", "rejected"] }
      }
    },
    "rejection": {
      "type": "object",
      "required": ["document_id", "reason", "rejected_by", "timestamp"],
      "properties": {
        "document_id": { "type": "string" },
        "reason": { "type": "string", "minLength": 10 },
        "rejected_by": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "filters": {
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "status": { "type": "string" },
        "search": { "type": "string" }
      }
    },
    "pagination": {
      "type": "object",
      "required": ["total", "page", "per_page"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "page": { "type": "integer", "minimum": 1 },
        "per_page": { "type": "integer" }
      }
    }
  },
  "required": ["feature_id", "depends_on"]
}
