{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Validation Schema — 006-analytics",
  "description": "Data structures and validation rules for feature NNN-short-name. All objects used by this feature must conform to these schemas.",
  "version": "1.0",
  "definitions": {
    "example_object": {
      "type": "object",
      "description": "Example data structure used by this feature",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]+$",
          "description": "Unique identifier (alphanumeric + hyphens)"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name of the entity"
        },
        "status": {
          "type": "string",
          "enum": ["not-started", "in-progress", "completed"],
          "description": "Current status (must be one of these values)"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 datetime (e.g., 2026-04-10T14:30:00Z)"
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000,
          "description": "Monetary amount in USD (0 to 10M)"
        },
        "is_verified": {
          "type": "boolean",
          "description": "True if verified by professional, false otherwise"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "minItems": 0,
          "maxItems": 10,
          "uniqueItems": true,
          "description": "List of tags (0–10 items, each 1–50 chars, no duplicates)"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
          },
          "description": "Key-value pairs for additional context (values must be string, number, or boolean)"
        }
      },
      "required": ["id", "name", "status", "timestamp"],
      "additionalProperties": false
    },
    "error_response": {
      "type": "object",
      "description": "Standard error response structure",
      "properties": {
        "error_code": {
          "type": "string",
          "pattern": "^[A-Z_]+$",
          "description": "Machine-readable error code (e.g., INVALID_INPUT, NOT_FOUND)"
        },
        "message": {
          "type": "string",
          "description": "Human-readable error message"
        },
        "details": {
          "type": "object",
          "description": "Additional context (field names with specific errors, etc.)"
        }
      },
      "required": ["error_code", "message"]
    }
  }
}

