{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Analytics Validation Schema",
  "description": "Validates data model for the Analytics & Reports screen (006).",
  "type": "object",
  "properties": {
    "feature_id": { "type": "string", "const": "006-analytics" },
    "depends_on": { "type": "array", "contains": { "const": "000-foundation" } },
    "time_periods": {
      "type": "array",
      "items": { "type": "string", "enum": ["7d", "30d", "90d", "1y", "all"] },
      "minItems": 5
    },
    "kpi_card": {
      "type": "object",
      "required": ["label", "value", "change_pct", "icon"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" },
        "change_pct": { "type": "number" },
        "icon": { "type": "string" }
      }
    },
    "revenue_breakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "title", "transaction_count", "revenue", "share_pct", "gradient"],
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "transaction_count": { "type": "integer", "minimum": 0 },
          "revenue": { "type": "number", "minimum": 0 },
          "share_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "gradient": { "type": "string" }
        }
      },
      "minItems": 3,
      "maxItems": 3
    },
    "user_growth": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "icon", "new_users", "growth_pct"],
        "properties": {
          "role": { "type": "string" },
          "icon": { "type": "string" },
          "new_users": { "type": "integer", "minimum": 0 },
          "growth_pct": { "type": "number" }
        }
      },
      "minItems": 6,
      "maxItems": 6
    },
    "top_partners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "rating", "referrals"],
        "properties": {
          "name": { "type": "string" },
          "rating": { "type": "number", "minimum": 1, "maximum": 5 },
          "referrals": { "type": "integer", "minimum": 0 }
        }
      },
      "minItems": 3,
      "maxItems": 3
    },
    "activity_24h": {
      "type": "object",
      "required": ["active_users", "documents_uploaded", "new_transactions", "partner_referrals"],
      "properties": {
        "active_users": { "type": "integer", "minimum": 0 },
        "documents_uploaded": { "type": "integer", "minimum": 0 },
        "new_transactions": { "type": "integer", "minimum": 0 },
        "partner_referrals": { "type": "integer", "minimum": 0 }
      }
    },
    "report_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "icon"],
        "properties": {
          "label": { "type": "string" },
          "icon": { "type": "string" }
        }
      },
      "minItems": 6
    }
  },
  "required": ["feature_id", "depends_on"]
}
