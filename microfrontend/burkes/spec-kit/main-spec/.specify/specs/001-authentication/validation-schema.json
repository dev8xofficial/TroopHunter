{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthenticationPayload",
  "type": "object",
  "required": ["role", "email", "password"],
  "properties": {
    "role": {
      "type": "string",
      "enum": ["client", "attorney", "cpa", "agent", "lender", "service", "admin"]
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "password": {
      "type": "string",
      "minLength": 8
    }
  }
}
