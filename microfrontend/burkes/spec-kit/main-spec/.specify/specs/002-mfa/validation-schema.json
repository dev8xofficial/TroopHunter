{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MFAPayload",
  "type": "object",
  "required": ["code"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "trustDevice": {
      "type": "boolean",
      "default": false
    }
  }
}
