{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FoundationSchema",
  "type": "object",
  "properties": {
    "design_tokens": {
      "type": "object",
      "required": ["colors", "typography"],
      "properties": {
        "colors": {
          "type": "object",
          "properties": {
            "primary": {"type": "array", "items": {"type": "string"}},
            "neutral": {"type": "array"}
          }
        },
        "typography": {
          "type": "object"
        }
      }
    }
  }
}
