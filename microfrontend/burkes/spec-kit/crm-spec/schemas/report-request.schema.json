{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRM Report Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "date_range"],
  "properties": {
    "scope": { "type": "string", "enum": ["department", "cross_department", "agent"] },
    "department": { "type": ["string", "null"], "enum": ["insurance", "mortgage", "real_estate", null] },
    "agent_id": { "type": ["string", "null"] },
    "date_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "format": "date" },
        "to": { "type": "string", "format": "date" }
      }
    },
    "metrics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "group_by": { "type": ["string", "null"] }
  }
}
