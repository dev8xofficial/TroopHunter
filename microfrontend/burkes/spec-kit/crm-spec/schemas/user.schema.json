{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRM User",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "role", "full_name", "email", "active"],
  "properties": {
    "id": { "type": "string", "pattern": "^USR-[A-Z]{2}-[0-9]{3}$" },
    "role": { "type": "string", "enum": ["OW", "IA", "ML", "RA", "PA"] },
    "full_name": { "type": "string" },
    "email": { "type": "string", "format": "email" },
    "departments": {
      "type": "array",
      "items": { "type": "string", "enum": ["insurance", "mortgage", "real_estate"] }
    },
    "active": { "type": "boolean" },
    "license_number": { "type": ["string", "null"] },
    "created_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
