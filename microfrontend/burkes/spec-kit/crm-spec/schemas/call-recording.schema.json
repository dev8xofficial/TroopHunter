{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Call Recording Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "call_id", "department", "recorded_at", "expires_at", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^REC-[0-9]{6}$" },
    "call_id": { "type": "string" },
    "department": { "type": "string", "enum": ["insurance", "mortgage", "real_estate"] },
    "provider_id": { "type": ["string", "null"] },
    "storage_uri": { "type": ["string", "null"] },
    "recorded_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["available", "failed", "expired", "exported"] },
    "access_scope": { "type": "string", "enum": ["department", "platform_admin"] }
  }
}
