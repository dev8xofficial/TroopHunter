{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRM Video Meeting",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "provider", "status", "starts_at"],
  "properties": {
    "id": { "type": "string" },
    "provider": { "type": "string", "enum": ["teams", "google_meet"] },
    "status": { "type": "string", "enum": ["scheduled", "launched", "completed", "cancelled"] },
    "starts_at": { "type": "string", "format": "date-time" },
    "ends_at": { "type": ["string", "null"], "format": "date-time" },
    "contact_id": { "type": ["string", "null"] },
    "calendar_event_id": { "type": ["string", "null"] },
    "recording_url": { "type": ["string", "null"], "format": "uri" },
    "retention_expires_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
