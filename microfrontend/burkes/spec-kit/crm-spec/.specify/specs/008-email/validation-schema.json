{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRM Email Validation Schema",
  "type": "object",
  "required": ["feature_id", "email", "inbox"],
  "properties": {
    "feature_id": { "type": "string", "const": "008-email" },
    "email": { "type": "object" },
    "inbox": { "type": "array" },
    "unresolved_messages": { "type": "array" }
  }
}
