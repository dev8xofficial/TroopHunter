{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRM Reports Validation Schema",
  "type": "object",
  "required": ["feature_id", "report", "filters", "metrics"],
  "properties": {
    "feature_id": { "type": "string", "const": "015-reports" },
    "report": { "type": "object" },
    "filters": { "type": "object" },
    "metrics": { "type": "object" },
    "breakdowns": { "type": "array" }
  }
}
