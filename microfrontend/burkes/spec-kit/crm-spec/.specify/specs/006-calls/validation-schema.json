{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRM Calls Validation Schema",
  "type": "object",
  "required": ["feature_id", "call", "recording_reference"],
  "properties": {
    "feature_id": { "type": "string", "const": "006-calls" },
    "call": { "type": "object" },
    "recording_reference": { "type": "object" },
    "call_log": { "type": "array" }
  }
}
