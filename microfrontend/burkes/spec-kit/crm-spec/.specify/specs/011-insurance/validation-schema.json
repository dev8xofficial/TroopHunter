{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRM Insurance Validation Schema",
  "type": "object",
  "required": ["feature_id", "insurance_record", "policy", "required_intake_fields"],
  "properties": {
    "feature_id": { "type": "string", "const": "011-insurance" },
    "insurance_record": { "type": "object" },
    "policy": { "type": "object" },
    "required_intake_fields": { "type": "array" },
    "sync_state": { "type": "object" }
  }
}
