{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRM Tasks Structure",
  "type": "object",
  "required": [
    "feature_id",
    "spec",
    "plan",
    "status",
    "created",
    "tasks"
  ],
  "properties": {
    "feature_id": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9-]+$"
    },
    "spec": { "type": "string" },
    "plan": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["Not Started", "In Progress", "Complete"]
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["Not Started", "In Progress", "Blocked", "Complete"]
          },
          "description": { "type": "string" }
        }
      }
    }
  }
}
