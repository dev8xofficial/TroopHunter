{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRM Spec Structure",
  "type": "object",
  "required": [
    "feature_id",
    "status",
    "created",
    "screen_module",
    "sections"
  ],
  "properties": {
    "feature_id": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9-]+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "approved", "implemented", "deprecated"]
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "screen_module": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": { "type": "string" },
      "allOf": [
        { "contains": { "const": "Overview" } },
        { "contains": { "const": "Problem Statement" } },
        { "contains": { "const": "Goals" } },
        { "contains": { "const": "Functional Requirements" } },
        { "contains": { "const": "Data & State" } },
        { "contains": { "const": "Success Criteria" } }
      ]
    }
  }
}
