{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRM Plan Structure",
  "type": "object",
  "required": [
    "feature_id",
    "spec",
    "status",
    "created",
    "estimated_effort",
    "phases"
  ],
  "properties": {
    "feature_id": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9-]+$"
    },
    "spec": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["Draft", "In Review", "Approved"]
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "estimated_effort": {
      "type": "string",
      "enum": ["XS", "S", "M", "L", "XL"]
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "goal", "exit_criteria"],
        "properties": {
          "name": { "type": "string" },
          "goal": { "type": "string" },
          "exit_criteria": { "type": "string" }
        }
      }
    }
  }
}
