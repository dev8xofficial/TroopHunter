{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "document.schema.json",
  "title": "Document",
  "type": "object",
  "required": ["id", "transaction_id", "name", "category", "status", "uploaded_by", "uploaded_at"],
  "additionalProperties": false,
  "properties": {
    "id":             { "type": "string", "format": "uuid" },
    "transaction_id": { "type": "string", "format": "uuid" },
    "name":           { "type": "string", "minLength": 1, "maxLength": 255 },
    "file_type": {
      "type": "string",
      "enum": ["pdf", "docx", "jpeg", "png"],
      "description": "Normalized file extension"
    },
    "file_size_bytes":{ "type": "integer", "minimum": 0 },
    "file_size_label":{ "type": "string", "description": "Human-readable e.g. '2.4 MB'" },
    "category": {
      "type": "string",
      "enum": ["purchase_sale", "mortgage", "legal_closing", "insurance", "tax", "other"]
    },
    "status": {
      "type": "string",
      "enum": ["needs_signature", "under_review", "needs_review", "approved", "signed", "rejected"]
    },
    "uploaded_by":   { "$ref": "user.schema.json#/definitions/UserRef" },
    "uploaded_at":   { "type": "string", "format": "date-time" },
    "signed_by":     { "$ref": "user.schema.json#/definitions/UserRef" },
    "signed_at":     { "type": "string", "format": "date-time" },
    "signature_ref": { "type": "string", "description": "External e-signature reference ID" },
    "download_url":  { "type": "string", "format": "uri", "description": "Presigned URL, short-lived" },
    "created_at":    { "type": "string", "format": "date-time" },
    "updated_at":    { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "DocumentCategory": {
      "type": "object",
      "required": ["id", "label", "icon", "documents"],
      "properties": {
        "id":        { "type": "string" },
        "label":     { "type": "string" },
        "icon":      { "type": "string" },
        "documents": { "type": "array", "items": { "$ref": "#" } }
      }
    },
    "Attachment": {
      "type": "object",
      "required": ["document_id", "name", "file_type"],
      "properties": {
        "document_id": { "type": "string", "format": "uuid" },
        "name":        { "type": "string" },
        "file_type":   { "type": "string" },
        "file_size_label": { "type": "string" }
      }
    }
  }
}