{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "transaction.schema.json",
  "title": "Transaction",
  "type": "object",
  "required": ["id", "client_id", "property", "status", "current_stage", "stages"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "client_id": {
      "type": "string",
      "format": "uuid"
    },
    "property": {
      "$ref": "#/definitions/Property"
    },
    "status": {
      "type": "string",
      "enum": ["searching", "offer_submitted", "under_contract", "in_escrow", "closed", "cancelled"]
    },
    "status_label": {
      "type": "string",
      "description": "Human-readable status label e.g. 'Under Contract'"
    },
    "progress_pct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "current_stage": {
      "type": "integer",
      "minimum": 1
    },
    "total_stages": {
      "type": "integer",
      "default": 11
    },
    "stages": {
      "type": "array",
      "items": { "$ref": "#/definitions/TransactionStage" },
      "minItems": 1
    },
    "team": {
      "type": "array",
      "items": { "$ref": "user.schema.json#/definitions/TeamMember" }
    },
    "document_count": {
      "type": "integer",
      "minimum": 0
    },
    "next_appointment": {
      "$ref": "#/definitions/Appointment"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "closing_date_target": {
      "type": "string",
      "format": "date"
    }
  },

  "definitions": {
    "Property": {
      "type": "object",
      "required": ["address", "city", "state", "zip_code", "purchase_price"],
      "properties": {
        "full_address": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string", "minLength": 2, "maxLength": 2 },
        "zip_code": { "type": "string", "pattern": "^\\d{5}(-\\d{4})?$" },
        "purchase_price": { "type": "number", "minimum": 0 },
        "property_type": {
          "type": "string",
          "enum": ["single_family", "condo", "townhouse", "multi_family"]
        }
      }
    },

    "TransactionStage": {
      "type": "object",
      "required": ["id", "number", "title", "status"],
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["completed", "in_progress", "pending"]
        },
        "completed_at": { "type": "string", "format": "date-time" },
        "scheduled_at": { "type": "string", "format": "date-time" },
        "date_label": { "type": "string" },
        "sub_badges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "status"],
            "properties": {
              "label": { "type": "string" },
              "status": { "type": "string", "enum": ["complete", "in_progress", "pending"] }
            }
          }
        }
      }
    },

    "Appointment": {
      "type": "object",
      "required": ["label", "date"],
      "properties": {
        "label": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "date_short": { "type": "string", "description": "e.g. 'Feb 18'" },
        "time": { "type": "string" },
        "location": { "type": "string" }
      }
    },

    "ActivityItem": {
      "type": "object",
      "required": ["id", "icon", "label", "body", "timestamp"],
      "properties": {
        "id": { "type": "string" },
        "icon": { "type": "string" },
        "label": { "type": "string" },
        "body": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "time_ago": { "type": "string", "description": "Computed display value e.g. '2h ago'" }
      }
    }
  }
}
