{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Services Schema",
  "type": "object",
  "definitions": {
    "service_category_enum": {
      "type": "string",
      "enum": ["PLUMBING", "ROOFING", "ELECTRICAL", "CREDIT_REPAIR", "PAINTING", "CLEANING", "LANDSCAPING", "HVAC", "MOVING", "LOCKSMITH", "WINDOWS", "HANDYMAN"]
    },
    "service_provider": {
      "type": "object",
      "properties": {
        "provider_id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "$ref": "#/definitions/service_category_enum" },
        "is_recommended": { "type": "boolean" },
        "rating": { "type": "number", "minimum": 0, "maximum": 5 },
        "review_count": { "type": "integer", "minimum": 0 },
        "contact_phone": { "type": "string" },
        "contact_name": { "type": ["string", "null"] },
        "services_offered": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["provider_id", "name", "category", "rating", "review_count", "contact_phone"],
      "additionalProperties": false
    }
  }
}
