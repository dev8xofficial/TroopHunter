{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Foundation Schema",
  "type": "object",
  "definitions": {
    "role_enum": {
      "type": "string",
      "enum": ["ROLE_CLIENT", "ROLE_AGENT", "ROLE_LENDER", "ROLE_ATTORNEY", "ROLE_CPA", "ROLE_ADMIN"]
    },
    "transaction_state_enum": {
      "type": "string",
      "enum": [
        "INITIAL_CONSULTATION",
        "PROPERTY_SEARCH",
        "OFFER_NEGOTIATION",
        "UNDER_CONTRACT",
        "MORTGAGE_APPLICATION",
        "INSURANCE_SETUP",
        "ATTORNEY_TITLE_REVIEW",
        "INSPECTION_APPRAISAL",
        "MORTGAGE_UNDERWRITING",
        "FINAL_WALKTHROUGH",
        "CLOSING_DAY",
        "CLOSED"
      ]
    },
    "session_context": {
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "format": "uuid" },
        "roles": {
          "type": "array",
          "items": { "$ref": "#/definitions/role_enum" }
        },
        "transaction_id": { "type": "string", "format": "uuid" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "roles", "expires_at"],
      "additionalProperties": false
    },
    "activity_log_event": {
      "type": "object",
      "properties": {
        "event_id": { "type": "string", "format": "uuid" },
        "transaction_id": { "type": "string", "format": "uuid" },
        "event_type": { "type": "string" },
        "actor_id": { "type": "string", "format": "uuid" },
        "actor_role": { "$ref": "#/definitions/role_enum" },
        "payload": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" },
        "visible_to": {
          "type": "array",
          "items": { "$ref": "#/definitions/role_enum" }
        }
      },
      "required": ["event_id", "transaction_id", "event_type", "actor_id", "actor_role", "timestamp", "visible_to"],
      "additionalProperties": false
    }
  }
}
