{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mortgage Schema",
  "type": "object",
  "definitions": {
    "app_status_enum": {
      "type": "string",
      "enum": ["INCOMPLETE", "IN_PROGRESS", "SUBMITTED"]
    },
    "personal_info_schema": {
      "type": "object",
      "properties": {
        "first_name": { "type": "string" },
        "last_name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "dob": { "type": "string", "format": "date" },
        "ssn_last_four": { "type": "string", "pattern": "^\\d{4}$" },
        "is_complete": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "property_details_schema": {
      "type": "object",
      "properties": {
        "property_address": { "type": "string" },
        "purchase_price": { "type": "number" },
        "down_payment": { "type": "number" },
        "loan_amount_requested": { "type": "number" },
        "property_type": { "type": "string", "enum": ["Single Family Home", "Condominium", "Townhouse", "Multi-Family"] },
        "is_complete": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "employer_schema": {
      "type": "object",
      "properties": {
        "employer_name": { "type": "string" },
        "position_title": { "type": "string" },
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": ["string", "null"], "format": "date" },
        "annual_income": { "type": "number" }
      },
      "required": ["employer_name", "position_title", "start_date", "annual_income"],
      "additionalProperties": false
    },
    "mortgage_application": {
      "type": "object",
      "properties": {
        "application_id": { "type": "string", "format": "uuid" },
        "transaction_id": { "type": "string", "format": "uuid" },
        "status": { "$ref": "#/definitions/app_status_enum" },
        "progress_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "personal_info": { "$ref": "#/definitions/personal_info_schema" },
        "property_details": { "$ref": "#/definitions/property_details_schema" },
        "employment_history": {
          "type": "array",
          "items": { "$ref": "#/definitions/employer_schema" }
        },
        "employment_is_complete": { "type": "boolean" }
      },
      "required": ["application_id", "transaction_id", "status", "progress_percent"],
      "additionalProperties": false
    }
  }
}
