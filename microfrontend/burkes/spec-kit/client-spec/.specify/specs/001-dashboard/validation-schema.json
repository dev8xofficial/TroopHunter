{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dashboard Schema",
  "type": "object",
  "definitions": {
    "dashboard_metrics": {
      "type": "object",
      "properties": {
        "transaction_progress_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "current_stage": { "$ref": "../000-foundation/validation-schema.json#/definitions/transaction_state_enum" },
        "stage_label": { "type": "string" },
        "pending_signatures_count": { "type": "integer", "minimum": 0 },
        "total_documents": { "type": "integer", "minimum": 0 },
        "insurance_completed_count": { "type": "integer", "minimum": 0, "maximum": 3 },
        "insurance_total_count": { "type": "integer", "const": 3 },
        "next_appointment_date": { "type": ["string", "null"], "format": "date-time" },
        "next_appointment_label": { "type": ["string", "null"] }
      },
      "required": ["transaction_progress_percent", "current_stage", "pending_signatures_count", "insurance_completed_count", "insurance_total_count"],
      "additionalProperties": false
    },
    "notification_alert": {
      "type": "object",
      "properties": {
        "alert_id": { "type": "string", "format": "uuid" },
        "severity": { "type": "string", "enum": ["INFO", "WARNING", "ERROR"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "action_endpoints": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["alert_id", "severity", "title", "description"],
      "additionalProperties": false
    }
  }
}
