{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Documents Schema",
  "type": "object",
  "definitions": {
    "document_category_enum": {
      "type": "string",
      "enum": ["PURCHASE", "FINANCIAL", "LEGAL", "OTHER"]
    },
    "document_status_enum": {
      "type": "string",
      "enum": ["NEEDS_SIGNATURE", "UNDER_REVIEW", "APPROVED"]
    },
    "document": {
      "type": "object",
      "properties": {
        "document_id": { "type": "string", "format": "uuid" },
        "transaction_id": { "type": "string", "format": "uuid" },
        "filename": { "type": "string", "maxLength": 255 },
        "mime_type": { "type": "string" },
        "size_bytes": { "type": "integer", "maximum": 26214400 },
        "category": { "$ref": "#/definitions/document_category_enum" },
        "status": { "$ref": "#/definitions/document_status_enum" },
        "uploaded_by_id": { "type": "string", "format": "uuid" },
        "uploaded_by_role": { "$ref": "../000-foundation/validation-schema.json#/definitions/role_enum" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["document_id", "transaction_id", "filename", "size_bytes", "category", "status", "uploaded_by_role", "created_at"],
      "additionalProperties": false
    },
    "document_upload_req": {
      "type": "object",
      "properties": {
        "filename": { "type": "string" },
        "category": { "$ref": "#/definitions/document_category_enum" }
      },
      "required": ["filename", "category"],
      "additionalProperties": false
    },
    "document_sign_req": {
      "type": "object",
      "properties": {
        "signature_token": { "type": "string" },
        "ip_address": { "type": "string" }
      },
      "required": ["signature_token"],
      "additionalProperties": false
    }
  }
}
