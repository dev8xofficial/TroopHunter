{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Activity Log Event Schema",
  "description": "Canonical audit trail structure. Every state change must produce an activity_event entry (append-only, immutable).",
  "type": "object",
  "required": ["event_id", "transaction_id", "actor_role", "actor_id", "event_type", "timestamp", "visibility"],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^EV-[0-9]{10}$",
      "description": "Unique event identifier (immutable)"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^TXN-[0-9]{10}$",
      "description": "Reference to parent transaction"
    },
    "actor_role": {
      "type": "string",
      "enum": ["CL", "AG", "LN", "AT", "CP", "TC"],
      "description": "Role that triggered the event"
    },
    "actor_id": {
      "type": "string",
      "description": "User/system identifier (anonymized in certain views)"
    },
    "event_type": {
      "type": "string",
      "enum": ["transaction_created", "status_changed", "document_uploaded", "document_reviewed", "document_rejected", "message_sent", "message_read", "milestone_reached", "task_assigned", "task_completed", "insurance_updated", "mortgage_updated", "approval_given", "approval_denied", "comment_added", "reminder_sent", "user_invited", "user_removed", "system_notification"],
      "description": "Category of state change"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Human-readable summary of what changed"
    },
    "affected_field": {
      "type": "string",
      "description": "Which field was modified (e.g., 'transaction_status', 'document_count')"
    },
    "before_value": {
      "description": "Previous value (can be any JSON type)"
    },
    "after_value": {
      "description": "New value (can be any JSON type)"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "ip_address": { "type": "string" },
        "user_agent": { "type": "string" },
        "source_system": { "type": "string", "enum": ["portal", "api", "admin", "automation"] },
        "request_id": { "type": "string", "description": "For tracing request lifecycle" }
      },
      "description": "Technical context"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When event occurred (UTC, server-generated, immutable)"
    },
    "visibility": {
      "type": "object",
      "properties": {
        "visible_to_roles": {
          "type": "array",
          "items": { "type": "string", "enum": ["CL", "AG", "LN", "AT", "CP", "TC"] },
          "minItems": 1,
          "description": "Which roles can see this event"
        },
        "is_public": {
          "type": "boolean",
          "description": "Visible on client dashboard or internal only"
        },
        "requires_acknowledgment": {
          "type": "boolean",
          "description": "Does event require a user action?"
        }
      },
      "required": ["visible_to_roles"],
      "description": "Access control for this event"
    },
    "notification": {
      "type": "object",
      "properties": {
        "should_notify": { "type": "boolean" },
        "notify_roles": {
          "type": "array",
          "items": { "type": "string", "enum": ["CL", "AG", "LN", "AT", "CP", "TC"] }
        },
        "notification_type": { "type": "string", "enum": ["email", "sms", "push", "portal_banner"] },
        "template_key": { "type": "string" }
      },
      "description": "Notification rules triggered by this event"
    },
    "related_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_id": { "type": "string" },
          "document_name": { "type": "string" },
          "document_type": { "type": "string" }
        }
      },
      "description": "Files/attachments referenced by this event"
    },
    "parent_event_id": {
      "type": "string",
      "description": "If this event is a response to another event (optional chain)"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Arbitrary tags for filtering (e.g., 'critical', 'billing', 'legal')"
    }
  },
  "additionalProperties": false
}
