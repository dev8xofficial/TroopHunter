{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dashboard Validation Schema",
  "description": "Validates the dashboard data model for the Service Partner Portal.",
  "type": "object",
  "required": ["kpi_cards", "pending_referrals"],
  "properties": {
    "kpi_cards": {
      "type": "object",
      "required": ["new_referral_count", "active_job_count", "average_rating", "monthly_revenue"],
      "properties": {
        "new_referral_count": { "type": "integer", "minimum": 0 },
        "active_job_count": { "type": "integer", "minimum": 0 },
        "average_rating": { "type": "number", "minimum": 0, "maximum": 5 },
        "monthly_revenue": { "type": "number", "minimum": 0 }
      }
    },
    "pending_referrals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["referral_id", "client_name", "property_address", "service_type"],
        "properties": {
          "referral_id": { "type": "string", "pattern": "^TRX-[0-9]{5}$" },
          "client_name": { "type": "string" },
          "property_address": { "type": "string" },
          "service_type": { "type": "string" },
          "budget": { "type": "string" },
          "timeline": { "type": "string" }
        }
      }
    },
    "active_service_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["zip_code", "city", "referrals_per_month", "total_earned"],
        "properties": {
          "zip_code": { "type": "string", "pattern": "^[0-9]{5}$" },
          "city": { "type": "string" },
          "referrals_per_month": { "type": "integer", "minimum": 0 },
          "total_earned": { "type": "number", "minimum": 0 }
        }
      }
    },
    "recent_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reviewer_name", "rating", "date"],
        "properties": {
          "reviewer_name": { "type": "string" },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "date": { "type": "string" },
          "excerpt": { "type": "string" }
        }
      }
    }
  }
}
