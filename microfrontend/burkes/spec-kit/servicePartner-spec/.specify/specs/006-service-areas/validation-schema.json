{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServiceAreaSchemas",
  "definitions": {
    "AreaStatus": {
      "type": "string",
      "enum": ["active", "paused", "deleted"]
    },
    "DemandLevel": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "ServiceArea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_area_id",
        "partner_id",
        "zip_code",
        "city",
        "area_status",
        "added_at"
      ],
      "properties": {
        "service_area_id": { "type": "string", "format": "uuid" },
        "partner_id": { "type": "string", "format": "uuid" },
        "zip_code": { "type": "string", "pattern": "^[0-9]{5}$" },
        "city": { "type": "string", "maxLength": 100 },
        "area_status": { "$ref": "#/definitions/AreaStatus" },
        "referral_count_this_month": { "type": "integer", "minimum": 0 },
        "earned_this_month": { "type": "number", "minimum": 0 },
        "added_at": { "type": "string", "format": "date-time" },
        "deleted_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "AddServiceAreaRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zip_code"],
      "properties": {
        "zip_code": {
          "type": "string",
          "pattern": "^[0-9]{5}$"
        }
      }
    },
    "ServiceAreaRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zip_code", "city", "demand_level", "average_referral_value"],
      "properties": {
        "zip_code": { "type": "string", "pattern": "^[0-9]{5}$" },
        "city": { "type": "string", "maxLength": 100 },
        "demand_level": { "$ref": "#/definitions/DemandLevel" },
        "average_referral_value": { "type": "number", "minimum": 0 }
      }
    }
  }
}
