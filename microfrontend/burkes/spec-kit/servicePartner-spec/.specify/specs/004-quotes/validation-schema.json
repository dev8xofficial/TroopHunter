{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuoteSchemas",
  "definitions": {
    "EstimatedCompletionTime": {
      "type": "string",
      "enum": ["same_day", "1_2_days", "3_5_days", "1_2_weeks", "2_4_weeks"]
    },
    "QuoteStatus": {
      "type": "string",
      "enum": ["pending", "accepted", "declined", "expired"]
    },
    "QuoteSubmitRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_description",
        "labor_cost",
        "materials_cost",
        "estimated_completion_time"
      ],
      "properties": {
        "service_description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "labor_cost": {
          "type": "number",
          "minimum": 0.01
        },
        "materials_cost": {
          "type": "number",
          "minimum": 0
        },
        "estimated_completion_time": {
          "$ref": "#/definitions/EstimatedCompletionTime"
        },
        "additional_notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "Quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote_id",
        "referral_id",
        "partner_id",
        "service_description",
        "labor_cost",
        "materials_cost",
        "total_quote_amount",
        "estimated_completion_time",
        "quote_status",
        "submitted_at"
      ],
      "properties": {
        "quote_id": { "type": "string", "format": "uuid" },
        "referral_id": { "type": "string", "format": "uuid" },
        "transaction_ref": { "type": "string", "pattern": "^TRX-[0-9]+$" },
        "partner_id": { "type": "string", "format": "uuid" },
        "client_name": { "type": "string", "maxLength": 200 },
        "property_address": { "type": "string", "maxLength": 500 },
        "service_description": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "labor_cost": { "type": "number", "minimum": 0.01 },
        "materials_cost": { "type": "number", "minimum": 0 },
        "total_quote_amount": { "type": "number", "minimum": 0.01 },
        "estimated_completion_time": { "$ref": "#/definitions/EstimatedCompletionTime" },
        "additional_notes": { "type": ["string", "null"], "maxLength": 1000 },
        "quote_status": { "$ref": "#/definitions/QuoteStatus" },
        "submitted_at": { "type": "string", "format": "date-time" },
        "responded_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "QuoteStatistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance_rate",
        "average_response_time_hours",
        "total_quotes_sent"
      ],
      "properties": {
        "acceptance_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "average_response_time_hours": { "type": "number", "minimum": 0 },
        "total_quotes_sent": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
