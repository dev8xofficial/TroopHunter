{"$schema":"http://json-schema.org/draft-07/schema#","title":"Quotes Validation Schema","type":"object","required":["quote_form","recent_quotes","statistics"],"properties":{"quote_form":{"type":"object","required":["referral_id","service_description","labor_cost","materials_cost","total_amount","estimated_completion"],"properties":{"referral_id":{"type":"string","pattern":"^TRX-[0-9]{5}$"},"service_description":{"type":"string","minLength":10},"labor_cost":{"type":"number","minimum":0},"materials_cost":{"type":"number","minimum":0},"total_amount":{"type":"number","minimum":0},"estimated_completion":{"type":"string","enum":["same-day","1-2-days","3-5-days","1-2-weeks","2-4-weeks"]},"notes":{"type":"string","maxLength":500}}},"recent_quotes":{"type":"array","items":{"type":"object","required":["client_name","service_type","amount","quote_status"],"properties":{"client_name":{"type":"string"},"service_type":{"type":"string"},"amount":{"type":"number","minimum":0},"quote_status":{"type":"string","enum":["pending","accepted","declined"]},"sent_date":{"type":"string"}}}},"statistics":{"type":"object","properties":{"acceptance_rate":{"type":"number","minimum":0,"maximum":100},"avg_response_time_hours":{"type":"number","minimum":0},"total_quotes_sent":{"type":"integer","minimum":0}}}}}
