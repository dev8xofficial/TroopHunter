{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServicePartnerFoundationSchemas",
  "definitions": {
    "AccountStatus": {
      "type": "string",
      "enum": [
        "pending_verification",
        "active_verified",
        "suspended",
        "deactivated"
      ]
    },
    "MembershipType": {
      "type": "string",
      "enum": ["standard", "premium"]
    },
    "ActorRole": {
      "type": "string",
      "enum": ["service_partner", "admin", "system", "client", "agent"]
    },
    "ServiceCategory": {
      "type": "string",
      "enum": [
        "emergency_repairs",
        "installations",
        "inspections",
        "maintenance",
        "water_treatment_systems"
      ]
    },
    "NotificationChannel": {
      "type": "string",
      "enum": ["email", "sms", "in_app"]
    },
    "NotificationDeliveryStatus": {
      "type": "string",
      "enum": ["pending", "sent", "failed"]
    },
    "ReferralStatus": {
      "type": "string",
      "enum": [
        "new_lead",
        "contacted",
        "quoted",
        "quote_accepted",
        "scheduled",
        "in_progress",
        "completed",
        "awaiting_payment",
        "paid",
        "declined",
        "cancelled"
      ]
    },
    "SessionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partner_id",
        "company_name",
        "membership_type",
        "account_status",
        "service_area_zip_codes",
        "service_categories",
        "session_issued_at",
        "session_expires_at",
        "routing_priority_score"
      ],
      "properties": {
        "partner_id": {
          "type": "string",
          "format": "uuid"
        },
        "company_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "membership_type": {
          "$ref": "#/definitions/MembershipType"
        },
        "account_status": {
          "$ref": "#/definitions/AccountStatus"
        },
        "service_area_zip_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{5}$"
          },
          "minItems": 0,
          "maxItems": 50
        },
        "service_categories": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ServiceCategory"
          },
          "minItems": 0
        },
        "session_issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "session_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "routing_priority_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "ActivityLogEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_name",
        "actor_role",
        "actor_id",
        "entity_type",
        "entity_id",
        "payload",
        "occurred_at"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_name": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "actor_role": {
          "$ref": "#/definitions/ActorRole"
        },
        "actor_id": {
          "type": "string",
          "format": "uuid"
        },
        "entity_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "entity_id": {
          "type": "string",
          "format": "uuid"
        },
        "payload": {
          "type": "object"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "NotificationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notification_id",
        "trigger_event",
        "recipient_partner_id",
        "channel",
        "payload",
        "sent_at",
        "delivery_status"
      ],
      "properties": {
        "notification_id": {
          "type": "string",
          "format": "uuid"
        },
        "trigger_event": {
          "type": "string",
          "minLength": 1
        },
        "recipient_partner_id": {
          "type": "string",
          "format": "uuid"
        },
        "channel": {
          "$ref": "#/definitions/NotificationChannel"
        },
        "payload": {
          "type": "object"
        },
        "sent_at": {
          "type": "string",
          "format": "date-time"
        },
        "delivery_status": {
          "$ref": "#/definitions/NotificationDeliveryStatus"
        }
      }
    }
  }
}
