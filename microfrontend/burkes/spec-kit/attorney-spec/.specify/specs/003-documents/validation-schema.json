{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Document Module Schemas",
  "definitions": {
    "document_base": {
      "type": "object",
      "properties": {
        "document_id": { "type": "string", "format": "uuid" },
        "transaction_id": { "type": "string", "format": "uuid" },
        "category": {
          "type": "string",
          "enum": ["purchase_agreement", "closing_disclosure", "divorce_agreement", "legal_document", "financial_doc"]
        },
        "uploader_id": { "type": "string", "format": "uuid" },
        "status": {
          "type": "string",
          "enum": ["needs_review", "under_review", "approved", "needs_revision"]
        },
        "s3_key": { "type": "string" },
        "rejection_reason": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["document_id", "transaction_id", "category", "uploader_id", "status", "s3_key", "created_at"],
      "additionalProperties": false
    }
  }
}
