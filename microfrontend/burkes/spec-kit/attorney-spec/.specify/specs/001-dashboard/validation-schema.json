{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dashboard Aggregates Schema",
  "type": "object",
  "properties": {
    "stats": {
      "type": "object",
      "properties": {
        "active_transactions": { "type": "integer", "minimum": 0 },
        "pending_verification": { "type": "integer", "minimum": 0 },
        "pending_asset_splits": { "type": "integer", "minimum": 0 },
        "total_value_managed": { "type": "number", "minimum": 0 }
      },
      "required": ["active_transactions", "pending_verification", "pending_asset_splits", "total_value_managed"],
      "additionalProperties": false
    },
    "urgent_deadlines": {
      "type": "array",
      "items": { "$ref": "../002-transactions/validation-schema.json#/definitions/transaction_base" }
    },
    "recent_activity": {
      "type": "array",
      "items": { "$ref": "../000-foundation/validation-schema.json#/definitions/activity_log_event" }
    }
  },
  "required": ["stats", "urgent_deadlines", "recent_activity"],
  "additionalProperties": false
}
