{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Foundation Validation Schema",
  "description": "Validates data model for the Foundation layer (000).",
  "type": "object",
  "properties": {
    "feature_id": { "type": "string", "const": "000-foundation" },
    "attorney": {
      "type": "object",
      "required": ["name", "initials", "role", "firm"],
      "properties": {
        "name": { "type": "string" },
        "initials": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "role": { "type": "string", "const": "AT" },
        "firm": { "type": "string" }
      }
    },
    "navigation": {
      "type": "object",
      "required": ["items", "active_screen"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "type": "string" },
          "const": ["Dashboard", "Transactions", "Documents", "Clients", "Verification"]
        },
        "active_screen": { "type": "string" }
      }
    },
    "notifications": {
      "type": "object",
      "properties": {
        "unread_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "required": ["feature_id", "attorney", "navigation"]
}
