{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transaction Module Schemas",
  "definitions": {
    "transaction_base": {
      "type": "object",
      "properties": {
        "transaction_id": { "type": "string", "format": "uuid" },
        "client_id": { "type": "string", "format": "uuid" },
        "property_address": { "type": "string", "maxLength": 255 },
        "case_type": { "type": "string", "enum": ["purchase_closing", "sale_closing", "divorce_asset_split"] },
        "contract_amount": { "type": "number", "minimum": 0 },
        "closing_date": { "type": "string", "format": "date-time" },
        "transaction_status": {
          "type": "string",
          "enum": ["document_gathering", "agent_review", "under_attorney_review", "split_pending", "flagged", "title_review", "verified", "completed"]
        }
      },
      "required": ["transaction_id", "client_id", "property_address", "case_type", "contract_amount", "closing_date", "transaction_status"],
      "additionalProperties": false
    }
  }
}
