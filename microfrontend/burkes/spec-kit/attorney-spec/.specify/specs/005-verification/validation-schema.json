{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verification Validation Schema",
  "description": "Validates data model for the Verification screen (005).",
  "type": "object",
  "properties": {
    "feature_id": { "type": "string", "const": "005-verification" },
    "depends_on": { "type": "array", "contains": { "const": "000-foundation" } },
    "verification_panel": {
      "type": "object",
      "required": ["transaction_id", "client_name", "sale_price", "closing_date", "verification_step"],
      "properties": {
        "transaction_id": { "type": "string", "pattern": "^TRX-[0-9]{5}$" },
        "client_name": { "type": "string" },
        "property_address": { "type": "string" },
        "sale_price": { "type": "number", "minimum": 0 },
        "loan_amount": { "type": "number", "minimum": 0 },
        "down_payment": { "type": "number", "minimum": 0 },
        "closing_costs": { "type": "number", "minimum": 0 },
        "cash_to_close": { "type": "number", "minimum": 0 },
        "closing_date": { "type": "string", "format": "date" },
        "verification_step": { "type": "integer", "minimum": 1, "maximum": 5 },
        "attorney_status": {
          "type": "string",
          "enum": ["needs-verification", "in-progress", "verified", "flagged"]
        }
      }
    },
    "progress_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "state"],
        "properties": {
          "label": { "type": "string" },
          "state": { "type": "string", "enum": ["done", "active", "future"] }
        }
      },
      "minItems": 5, "maxItems": 5
    },
    "flag": {
      "type": "object",
      "required": ["discrepancy_type", "description"],
      "properties": {
        "discrepancy_type": {
          "type": "string",
          "enum": ["incorrect-sale-price", "loan-amount-mismatch", "missing-document", "closing-cost-error", "other"]
        },
        "description": { "type": "string", "minLength": 10 },
        "notify_parties": {
          "type": "array",
          "items": { "type": "string", "enum": ["agent", "lender", "client", "title-company"] }
        }
      }
    },
    "verify_confirmation": {
      "type": "object",
      "required": ["attorney_signature"],
      "properties": {
        "attorney_signature": { "type": "string", "minLength": 2 }
      }
    },
    "report": {
      "type": "object",
      "required": ["report_type", "format"],
      "properties": {
        "report_type": {
          "type": "string",
          "enum": ["transaction-summary", "verification-report", "asset-split-report", "activity-log"]
        },
        "transaction_id": { "type": "string" },
        "date_from": { "type": "string", "format": "date" },
        "date_to": { "type": "string", "format": "date" },
        "format": { "type": "string", "enum": ["pdf", "excel", "csv"] }
      }
    }
  },
  "required": ["feature_id", "depends_on"]
}
