{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verification Module Schemas",
  "definitions": {
    "verification_payload": {
      "type": "object",
      "properties": {
        "transaction_id": { "type": "string", "format": "uuid" },
        "sale_price": { "type": "number", "minimum": 0 },
        "loan_amount": { "type": "number", "minimum": 0 },
        "down_payment": { "type": "number", "minimum": 0 },
        "closing_costs": { "type": "number", "minimum": 0 },
        "attorney_signature": { "type": "string", "minLength": 2 }
      },
      "required": ["transaction_id", "sale_price", "loan_amount", "closing_costs", "attorney_signature"],
      "additionalProperties": false
    },
    "asset_split_payload": {
      "type": "object",
      "properties": {
        "transaction_id": { "type": "string", "format": "uuid" },
        "net_equity": { "type": "number", "minimum": 0 },
        "party_a_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "party_b_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "modification_reason": { "type": "string" }
      },
      "required": ["transaction_id", "net_equity", "party_a_percent", "party_b_percent"],
      "additionalProperties": false
    },
    "discrepancy_flag": {
      "type": "object",
      "properties": {
        "transaction_id": { "type": "string", "format": "uuid" },
        "discrepancy_type": { "type": "string" },
        "description": { "type": "string" },
        "notify_parties": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["transaction_id", "discrepancy_type", "description"],
      "additionalProperties": false
    }
  }
}
