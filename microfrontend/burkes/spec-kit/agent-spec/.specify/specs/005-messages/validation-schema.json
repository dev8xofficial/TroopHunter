{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Messages Validation Schema",
  "description": "Validates data model for the Messages screen (05).",
  "type": "object",
  "properties": {
    "feature_id": { "type": "string", "const": "005-messages" },
    "depends_on": { "type": "array", "contains": { "const": "000-foundation" } },
    "design_tokens_required": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["primary-navy","primary-gold","accent-blue","success-green","warning-orange","error-red","font-display","font-body"]
      }
    }
  },
  "required": ["feature_id", "depends_on"]
}
