{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tasks Structure",
  "description": "Meta-schema validating tasks.md structure requirements",
  "type": "object",
  "required": ["tasks"],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "priority", "complexity"],
        "properties": {
          "id": { "type": "string", "pattern": "^T-\\d{3}-\\d{2}$" },
          "name": { "type": "string" },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "complexity": { "type": "string", "enum": ["S", "M", "L", "XL"] }
        }
      }
    }
  }
}
