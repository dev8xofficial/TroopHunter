{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plan Structure",
  "description": "Meta-schema validating plan.md structure requirements",
  "type": "object",
  "required": ["objective", "prerequisites", "tasks"],
  "properties": {
    "objective": { "type": "string" },
    "prerequisites": { "type": "array" },
    "tasks": { "type": "array" },
    "cross_domain_dependencies": { "type": "array" },
    "timeline": { "type": "object" }
  }
}
