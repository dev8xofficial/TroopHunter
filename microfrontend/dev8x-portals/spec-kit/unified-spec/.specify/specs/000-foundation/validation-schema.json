{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Foundation validation schema",
  "description": "Validation definitions for 000-foundation.",
  "type": "object",
  "definitions": {
    "foundationQuery": {
      "type": "object",
      "description": "Request model for registry lookups.",
      "properties": {
        "domain_code": {
          "description": "Requested domain code",
          "type": "string"
        },
        "include_superseded": {
          "description": "Include superseded versions",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "foundationSnapshot": {
      "type": "object",
      "description": "Response envelope for shared registry reads.",
      "properties": {
        "module_count": {
          "description": "Total modules returned",
          "type": "integer"
        },
        "roles_count": {
          "description": "Total platform roles returned",
          "type": "integer"
        },
        "published_version": {
          "description": "Current publication version",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "module_count",
        "roles_count",
        "published_version"
      ]
    }
  }
}
