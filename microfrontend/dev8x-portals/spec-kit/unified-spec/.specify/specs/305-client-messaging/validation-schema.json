{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Client Messaging validation schema",
  "description": "Validation definitions for 305-client-messaging.",
  "type": "object",
  "definitions": {
    "clientMessageReply": {
      "type": "object",
      "description": "Client reply payload.",
      "properties": {
        "body": {
          "description": "Reply body",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "body"
      ]
    },
    "clientThreadUpdate": {
      "type": "object",
      "description": "Client thread status update.",
      "properties": {
        "status": {
          "description": "Requested thread status",
          "type": "string",
          "enum": [
            "read",
            "escalated",
            "closed"
          ]
        },
        "reason": {
          "description": "Update reason",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "status"
      ]
    },
    "clientThreadSummary": {
      "type": "object",
      "description": "Client thread response.",
      "properties": {
        "thread_id": {
          "description": "Thread identifier",
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "description": "Current status",
          "type": "string"
        },
        "last_message_at": {
          "description": "Latest message timestamp",
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "required": [
        "thread_id",
        "status",
        "last_message_at"
      ]
    }
  }
}
