{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Admin Interviews validation schema",
  "description": "Validation definitions for 104-admin-interviews.",
  "type": "object",
  "definitions": {
    "interviewSchedule": {
      "type": "object",
      "description": "Interview scheduling payload.",
      "properties": {
        "applicant_id": {
          "description": "Applicant identifier",
          "type": "string",
          "format": "uuid"
        },
        "interviewer_id": {
          "description": "Assigned interviewer",
          "type": "string",
          "format": "uuid"
        },
        "scheduled_for": {
          "description": "Interview start",
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "description": "Interview type",
          "type": "string",
          "enum": [
            "screening",
            "technical",
            "final"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "applicant_id",
        "interviewer_id",
        "scheduled_for",
        "type"
      ]
    },
    "interviewStatusUpdate": {
      "type": "object",
      "description": "Interview status update payload.",
      "properties": {
        "status": {
          "description": "New interview status",
          "type": "string",
          "enum": [
            "confirmed",
            "completed",
            "cancelled",
            "no_show"
          ]
        },
        "reason": {
          "description": "Update reason",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "status"
      ]
    },
    "interviewSummary": {
      "type": "object",
      "description": "Interview response summary.",
      "properties": {
        "interview_id": {
          "description": "Interview identifier",
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "description": "Current status",
          "type": "string"
        },
        "scheduled_for": {
          "description": "Scheduled time",
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "required": [
        "interview_id",
        "status",
        "scheduled_for"
      ]
    }
  }
}
