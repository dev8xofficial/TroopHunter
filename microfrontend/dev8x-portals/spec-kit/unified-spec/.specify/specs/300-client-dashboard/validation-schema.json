{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Client Dashboard validation schema",
  "description": "Validation definitions for 300-client-dashboard.",
  "type": "object",
  "definitions": {
    "clientDashboardQuery": {
      "type": "object",
      "description": "Client dashboard filter request.",
      "properties": {
        "date_from": {
          "description": "Reporting range start",
          "type": "string",
          "format": "date"
        },
        "date_to": {
          "description": "Reporting range end",
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "clientDashboardResponse": {
      "type": "object",
      "description": "Client dashboard summary response.",
      "properties": {
        "active_project_count": {
          "description": "Number of active projects",
          "type": "integer"
        },
        "open_ticket_count": {
          "description": "Open support tickets",
          "type": "integer"
        },
        "total_invoiced_amount": {
          "description": "Total invoiced amount",
          "type": "number"
        },
        "generated_at": {
          "description": "Snapshot timestamp",
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "required": [
        "active_project_count",
        "open_ticket_count",
        "total_invoiced_amount",
        "generated_at"
      ]
    }
  }
}
