{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Candidate Dashboard validation schema",
  "description": "Validation definitions for 200-candidate-dashboard.",
  "type": "object",
  "definitions": {
    "candidateDashboardQuery": {
      "type": "object",
      "description": "Candidate dashboard query.",
      "properties": {
        "date_from": {
          "description": "Reporting range start",
          "type": "string",
          "format": "date"
        },
        "date_to": {
          "description": "Reporting range end",
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "candidateDashboardResponse": {
      "type": "object",
      "description": "Candidate dashboard snapshot.",
      "properties": {
        "overall_completion_pct": {
          "description": "Completion percentage",
          "type": "number"
        },
        "current_step": {
          "description": "Current active step",
          "type": "string"
        },
        "quick_action_count": {
          "description": "Available actions",
          "type": "integer"
        },
        "generated_at": {
          "description": "Snapshot timestamp",
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "required": [
        "overall_completion_pct",
        "current_step",
        "quick_action_count",
        "generated_at"
      ]
    }
  }
}
