{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Authentication validation schema",
  "description": "Validation definitions for 001-authentication.",
  "type": "object",
  "definitions": {
    "loginRequest": {
      "type": "object",
      "description": "Credential validation request.",
      "properties": {
        "email": {
          "description": "Email address",
          "type": "string"
        },
        "password": {
          "description": "Submitted password",
          "type": "string"
        },
        "portal": {
          "description": "Requested portal",
          "type": "string",
          "enum": [
            "candidate",
            "client",
            "admin",
            "crm"
          ]
        },
        "remember_me": {
          "description": "Extend non-admin session lifetime",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "email",
        "password",
        "portal"
      ]
    },
    "registerRequest": {
      "type": "object",
      "description": "Candidate self-registration request.",
      "properties": {
        "first_name": {
          "description": "First name",
          "type": "string"
        },
        "last_name": {
          "description": "Last name",
          "type": "string"
        },
        "email": {
          "description": "Email address",
          "type": "string"
        },
        "password": {
          "description": "Password",
          "type": "string"
        },
        "password_confirmation": {
          "description": "Password confirmation",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "first_name",
        "last_name",
        "email",
        "password",
        "password_confirmation"
      ]
    },
    "logoutRequest": {
      "type": "object",
      "description": "Logout request payload.",
      "properties": {
        "all_devices": {
          "description": "Revoke all active sessions for the current user",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "authSessionResponse": {
      "type": "object",
      "description": "Authentication success envelope.",
      "properties": {
        "token": {
          "description": "Issued access token",
          "type": "string"
        },
        "portal": {
          "description": "Session portal",
          "type": "string"
        },
        "expires_at": {
          "description": "Session expiry",
          "type": "string",
          "format": "date-time"
        },
        "mfa_required": {
          "description": "Indicates whether MFA is pending",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "token",
        "portal",
        "expires_at",
        "mfa_required"
      ]
    },
    "authRegistrationResponse": {
      "type": "object",
      "description": "Registration success envelope.",
      "properties": {
        "user_id": {
          "description": "Created user",
          "type": "string",
          "format": "uuid"
        },
        "email": {
          "description": "Registered email",
          "type": "string"
        },
        "message": {
          "description": "Registration result message",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "user_id",
        "email",
        "message"
      ]
    },
    "logoutResponse": {
      "type": "object",
      "description": "Logout success envelope.",
      "properties": {
        "message": {
          "description": "Logout result",
          "type": "string"
        },
        "sessions_revoked": {
          "description": "Number of revoked sessions",
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "message",
        "sessions_revoked"
      ]
    }
  }
}
