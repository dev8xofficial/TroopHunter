{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Client Working Hours validation schema",
  "description": "Validation definitions for 304-client-working-hours.",
  "type": "object",
  "definitions": {
    "timeRangeQuery": {
      "type": "object",
      "description": "Time reporting filter.",
      "properties": {
        "project_id": {
          "description": "Project filter",
          "type": "string",
          "format": "uuid"
        },
        "date_from": {
          "description": "Reporting range start",
          "type": "string",
          "format": "date"
        },
        "date_to": {
          "description": "Reporting range end",
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "timeRangeSummary": {
      "type": "object",
      "description": "Time reporting response.",
      "properties": {
        "row_count": {
          "description": "Returned summary rows",
          "type": "integer"
        },
        "hours_total": {
          "description": "Total hours",
          "type": "number"
        },
        "latest_sync_at": {
          "description": "Latest sync time",
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "required": [
        "row_count",
        "hours_total",
        "latest_sync_at"
      ]
    }
  }
}
