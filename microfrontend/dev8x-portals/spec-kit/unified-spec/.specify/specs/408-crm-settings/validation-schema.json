{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRM Settings validation schema",
  "description": "Validation definitions for 408-crm-settings.",
  "type": "object",
  "definitions": {
    "crmSettingUpdate": {
      "type": "object",
      "description": "CRM setting update payload.",
      "properties": {
        "setting_key": {
          "description": "Setting identifier",
          "type": "string"
        },
        "value": {
          "description": "New value",
          "type": "string"
        },
        "approver_id": {
          "description": "Approver",
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "setting_key",
        "value"
      ]
    },
    "crmUserRoleUpdate": {
      "type": "object",
      "description": "CRM user provisioning or role update payload.",
      "properties": {
        "name": {
          "description": "Display name",
          "type": "string"
        },
        "email": {
          "description": "Email address",
          "type": "string"
        },
        "role": {
          "description": "CRM role",
          "type": "string",
          "enum": [
            "sales_rep",
            "manager"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "email",
        "role"
      ]
    },
    "crmSettingSummary": {
      "type": "object",
      "description": "CRM settings response.",
      "properties": {
        "record_id": {
          "description": "Record identifier",
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "description": "Lifecycle status",
          "type": "string"
        },
        "changed_by": {
          "description": "Latest editor",
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "record_id",
        "status"
      ]
    }
  }
}
