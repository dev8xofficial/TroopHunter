{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Contract",
    "description": "Client contract document",
    "type": "object",
    "required": [
        "id",
        "name",
        "project_id",
        "status"
    ],
    "properties": {
        "id": {
            "type": "string",
            "format": "uuid"
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
        },
        "project_id": {
            "type": "string",
            "format": "uuid"
        },
        "status": {
            "type": "string",
            "enum": [
                "draft",
                "pending",
                "signed"
            ]
        },
        "signed_date": {
            "type": "string",
            "format": "date-time"
        },
        "created_at": {
            "type": "string",
            "format": "date-time"
        }
    },
    "additionalProperties": false
}
