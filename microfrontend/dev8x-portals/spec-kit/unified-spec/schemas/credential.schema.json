{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Credential",
    "description": "Login credential payload",
    "type": "object",
    "required": [
        "email",
        "password"
    ],
    "properties": {
        "email": {
            "type": "string",
            "format": "email"
        },
        "password": {
            "type": "string",
            "minLength": 8
        },
        "portal": {
            "type": "string",
            "enum": [
                "candidate",
                "client",
                "admin"
            ]
        },
        "totp_code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
        },
        "remember_me": {
            "type": "boolean"
        }
    },
    "additionalProperties": false
}