{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Pipeline Card",
    "description": "Kanban pipeline card",
    "type": "object",
    "required": [
        "id",
        "candidate_id",
        "stage"
    ],
    "properties": {
        "id": {
            "type": "string",
            "format": "uuid"
        },
        "candidate_id": {
            "type": "string",
            "format": "uuid"
        },
        "stage": {
            "type": "string"
        },
        "role": {
            "type": "string"
        },
        "days_in_stage": {
            "type": "integer",
            "minimum": 0
        },
        "tags": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "urgent": {
            "type": "boolean"
        }
    },
    "additionalProperties": false
}
