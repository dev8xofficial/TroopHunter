{
  "name": "autonomous-design-engine",
  "version": "0.1.0",
  "description": "Autonomous Design Engine — AI that autonomously designs websites/products from a business brief",
  "type": "module",
  "private": true,
  "bin": {
    "ade": "./src/cli.ts"
  },
  "scripts": {
    "dev": "cd harness && npx vite --port 5199",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ade": "tsx src/cli.ts",
    "spike": "tsx spike.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.196",
    "@anthropic-ai/sdk": "^0.93.0",
    "@axe-core/playwright": "^4.10.1",
    "commander": "^13.1.0",
    "dotenv": "^16.5.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.52.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
