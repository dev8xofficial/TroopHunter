# ─── ADE Provider ───
# agent-sdk = Pro-credit Agent SDK (default dev, no API key needed)
# api       = Anthropic API key (production)
# local     = Ollama local model (fallback/offline)
ADE_PROVIDER=api

# ─── Model ───
ADE_MODEL=claude-sonnet-4-20250514

# ─── Budget caps (hard, F-MOD-04) ───
ADE_MAX_RUN_TOKENS=500000
ADE_MAX_RUN_SECONDS=600
ADE_MAX_MODEL_CALLS=30

# ─── Temperatures ───
ADE_GEN_TEMPERATURE=0.7
ADE_CRITIC_TEMPERATURE=0.2

# ─── API key (only for ADE_PROVIDER=api) ───
ANTHROPIC_API_KEY=

# ─── Ollama (only for ADE_PROVIDER=local) ───
ADE_OLLAMA_BASE_URL=http://localhost:11434
ADE_OLLAMA_MODEL=llava
