{
  "tree-generator.exclude": {
    "**/node_modules": true,
    "**/public": true,
    "**/fonts": true,
    "**/images": true
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "editor.formatOnSave": true,
  "eslint.workingDirectories": ["../microfrontend", "../microservices", "../packages/validator"],
  "files.associations": {
    "wrangler.json": "jsonc"
  }
}
